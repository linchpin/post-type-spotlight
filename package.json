{
  "name": "post-type-spotlight",
  "version": "3.2.0",
  "description": "Easily allows you to designate posts, pages, attachments and custom post types as featured.",
  "author": "Linchpin <sayhi@linchpin.com>",
  "license": "GPL-2.0-or-later",
  "prettier": "@wordpress/prettier-config",
  "scripts": {
    "prepare": "husky",
    "build": "npm run build:blocks && npm run build:admin",
    "build:blocks": "wp-scripts build --webpack-src-dir=blocks/src --output-path=blocks/build",
    "build:admin": "wp-scripts build --config admin/webpack.config.js",
    "start": "wp-scripts start --webpack-src-dir=blocks/src --output-path=blocks/build",
    "start:admin": "wp-scripts start --config admin/webpack.config.js",
    "format": "wp-scripts format blocks/src admin/src tests",
    "lint:js": "wp-scripts lint-js blocks/src admin/src",
    "lint:css": "wp-scripts lint-style \"blocks/src/**/*.scss\" \"admin/src/**/*.scss\"",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "packages-update": "wp-scripts packages-update",
    "test:playground": "playwright test --config=tests/playground/playwright.config.ts",
    "test:playground:headed": "playwright test --config=tests/playground/playwright.config.ts --headed",
    "test:playground:ui": "playwright test --config=tests/playground/playwright.config.ts --ui"
  },
  "lint-staged": {
    "{blocks,admin}/src/**/*.{js,jsx}": [
      "wp-scripts lint-js"
    ],
    "{blocks,admin}/src/**/*.{css,scss}": [
      "wp-scripts lint-style"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@linchpinagency/commitlint-config": "^1.3.1",
    "@linchpinagency/ui": "^0.3.2",
    "@playwright/test": "^1.64.1",
    "@wordpress/admin-ui": "^2.12.0",
    "@wordpress/api-fetch": "^7.57.0",
    "@wordpress/block-editor": "^17.1.0",
    "@wordpress/blocks": "^16.2.0",
    "@wordpress/components": "^40.1.0",
    "@wordpress/core-data": "^8.2.0",
    "@wordpress/data": "^10.57.0",
    "@wordpress/dataviews": "^19.1.0",
    "@wordpress/dom-ready": "^4.57.0",
    "@wordpress/edit-post": "^8.57.0",
    "@wordpress/element": "^8.8.0",
    "@wordpress/hooks": "^4.57.0",
    "@wordpress/html-entities": "^4.57.0",
    "@wordpress/i18n": "^6.30.0",
    "@wordpress/icons": "^16.0.0",
    "@wordpress/notices": "^5.57.0",
    "@wordpress/plugins": "^7.57.0",
    "@wordpress/prettier-config": "^4.57.0",
    "@wordpress/primitives": "^4.57.0",
    "@wordpress/scripts": "^35.0.0",
    "@wordpress/theme": "^2.3.0",
    "@wp-playground/cli": "^3.1.59",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "npm:wp-prettier@^3.9.6",
    "webpack-remove-empty-scripts": "^1.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linchpin/post-type-spotlight.git"
  },
  "bugs": {
    "url": "https://github.com/linchpin/post-type-spotlight/issues",
    "email": "sayhi@linchpin.com"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "browserslist": [
    "defaults"
  ],
  "overrides": {
    "serialize-javascript": "^7.1.1",
    "minimatch": "^10.2.6",
    "markdown-it": "^15.0.3",
    "linkify-it": "^6.1.0",
    "extract-zip": "^2.0.1",
    "tmp": "^0.2.7"
  }
}
