{
  "name": "post-type-spotlight",
  "version": "3.1.1",
  "description": "Easily allows you to designate posts, pages, attachments and custom post types as featured.",
  "author": "Linchpin <sayhi@linchpin.com>",
  "license": "GPL-2.0-or-later",
  "prettier": "@wordpress/prettier-config",
  "scripts": {
    "prepare": "husky",
    "build": "wp-scripts build --webpack-src-dir=blocks/src --output-path=blocks/build",
    "start": "wp-scripts start --webpack-src-dir=blocks/src --output-path=blocks/build",
    "format": "wp-scripts format blocks/src tests",
    "lint:js": "wp-scripts lint-js blocks/src",
    "lint:css": "wp-scripts lint-style \"blocks/src/**/*.scss\"",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "packages-update": "wp-scripts packages-update",
    "test:playground": "playwright test --config=tests/playground/playwright.config.ts",
    "test:playground:headed": "playwright test --config=tests/playground/playwright.config.ts --headed",
    "test:playground:ui": "playwright test --config=tests/playground/playwright.config.ts --ui"
  },
  "lint-staged": {
    "blocks/src/**/*.{js,jsx}": [
      "wp-scripts lint-js"
    ],
    "blocks/src/**/*.{css,scss}": [
      "wp-scripts lint-style"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@linchpinagency/commitlint-config": "^1.3.1",
    "@playwright/test": "^1.63.0",
    "@wordpress/block-editor": "^17.1.0",
    "@wordpress/blocks": "^16.1.0",
    "@wordpress/components": "^40.1.0",
    "@wordpress/core-data": "^8.1.0",
    "@wordpress/data": "^10.56.0",
    "@wordpress/edit-post": "^8.56.0",
    "@wordpress/hooks": "^4.56.0",
    "@wordpress/i18n": "^6.29.0",
    "@wordpress/plugins": "^7.56.0",
    "@wordpress/prettier-config": "^4.56.0",
    "@wordpress/primitives": "^4.56.0",
    "@wordpress/scripts": "^35.0.0",
    "@wp-playground/cli": "^3.1.55",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "npm:wp-prettier@^3.9.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linchpin/post-type-spotlight.git"
  },
  "bugs": {
    "url": "https://github.com/linchpin/post-type-spotlight/issues",
    "email": "sayhi@linchpin.com"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "browserslist": [
    "defaults"
  ],
  "overrides": {
    "serialize-javascript": "^7.1.2",
    "minimatch": "^10.2.6",
    "markdown-it": "^15.0.2",
    "linkify-it": "^6.1.0",
    "extract-zip": "^2.0.1",
    "tmp": "^0.2.7"
  }
}
