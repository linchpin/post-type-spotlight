{
  "name": "linchpin/post-type-spotlight",
  "description": "A simple plugin to allow authors and admins to feature post types",
  "homepage": "https://github.com/linchpin/post-type-spotlight",
  "authors": [
    {
      "name": "Aaron Ware",
      "email": "aaron@linchpin.com"
    },
    {
      "name": "Jonathan Desrosiers",
      "role": "Developer"
    },
    {
      "name": "Linchpin",
      "email": "sayhi@linchpin.com",
      "homepage": "https://linchpin.com",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/linchpin/post-type-spotlight/issues",
    "source": "https://github.com/linchpin/post-type-spotlight"
  },
  "license": "GPL-2.0-or-later",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=7.4",
    "composer/installers": "^2.2.0"
  },
  "require-dev": {
    "linchpin/coding-standards": "^1.3.0"
  },
  "scripts": {
    "php-lint": "parallel-lint --exclude vendor --exclude node_modules --exclude blocks/node_modules --exclude blocks/build .",
    "phpcs": "phpcs --standard=phpcs.xml.dist",
    "phpcbf": "phpcbf --standard=phpcs.xml.dist",
    "check-branch-cs": "Linchpin\\Composer\\Actions::check_branch_cs",
    "check-staged-cs": "Linchpin\\Composer\\Actions::check_staged_cs",
    "lint": [
      "@php-lint",
      "@phpcs"
    ],
    "build": "bash scripts/build.sh"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.2"
    }
  }
}
