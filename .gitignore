# Dependencies
node_modules/
vendor/

# Build output. Anchored with a leading slash: an unanchored `build/` also
# matches blocks/build, which IS committed because the plugin loads it at
# runtime and .distignore does not exclude it.
/build/
/test-results/
/zip/

# Tool caches and reports
.phpcs.cache
phpcs.cache
phpcs-report.xml
.phpunit.result.cache
.php-cs-fixer.cache
playwright-report/

# Logs and databases
*.log
*.sql
*.sqlite

# OS noise
.DS_Store
